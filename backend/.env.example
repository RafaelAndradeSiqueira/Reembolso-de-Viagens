APP_NAME="Reembolso de Viagens"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR

FRONTEND_URL=http://localhost:5173

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
OPENROUTER_CA_BUNDLE=

DB_CONNECTION=sqlite
DB_MIGRAR_AUTOMATICAMENTE=true

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
